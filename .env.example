# EXAMPLE - NO SECRETS
# Historical baseline draft keys below are not all implemented. Processes do not auto-load this file.
# Use the implemented M3 settings at the end and the M3 runbook.
ALMRAG_DATABASE_URL=sqlite:///./data/alm.sqlite
ALMRAG_OLLAMA_BASE_URL=http://localhost:11434
ALMRAG_OLLAMA_MODEL=embeddinggemma-2
ALMRAG_QDRANT_URL=http://localhost:6333
ALMRAG_SEARCH_DEFAULT_TOP_K=10
ALMRAG_GITHUB_REMOTE_URL=
ALMRAG_NOTION_ROOT_PAGE=3fe8be2f-eeee-81d4-ad48-cddc61ba0f5c

# DRAFT V0.2: Set real URLs, secrets as runtime environment/secrets; never commit .env
ALMRAG_CHUNK_TARGET_TOKENS=512
ALMRAG_CHUNK_MAX_TOKENS=1024
ALMRAG_CHUNK_OVERLAP_TOKENS=64
ALMRAG_CHUNK_RESERVED_TOKENS=128
ALMRAG_API_RPS_DEFAULT=2
ALMRAG_API_BURST_DEFAULT=2
ALMRAG_API_MAX_INFLIGHT=2
ALMRAG_API_MIN_INTERVAL_MS=200
ALMRAG_API_REQUEST_TIMEOUT_SECONDS=30
ALMRAG_API_MAX_ATTEMPTS=5

# Implemented M3 environment settings (export explicitly; never commit real secrets)
ALMRAG_DATABASE_PATH=data/alm.sqlite
ALMRAG_ALLOWED_ORIGIN=https://localhost:8443
ALMRAG_LIVE_ALM_ENABLED=false
ALMRAG_LIVE_MODEL_ENABLED=false
ALMRAG_MODEL_PROFILE_PATH=
# ALMRAG_OLLAMA_AUTH_REF=env:MODEL_TOKEN
# ALMRAG_CA_BUNDLE=/path/to/trusted-ca.pem
# Chunk parameters are configured in the typed processing policy, not the draft env knobs above.

# M5 automatic summary delivery is implemented/tested with mocks, remote execution needs separate approval.
ALMRAG_NOTION_SUMMARY_ENABLED=false
# ALMRAG_NOTION_AUTH_REF=env:NOTION_TOKEN
ALMRAG_LIVE_VECTOR_ENABLED=false
