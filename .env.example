# ALMRAG_ATTACHMENT_ROOT=data/attachments
# ALMRAG_MODEL_PROFILE_PATH=/path/to/verified-model-profile.json
# ALMRAG_OLLAMA_AUTH_REF=env:MODEL_TOKEN
