# Copy to repository root .env.intranet; chmod 600 .env.intranet.
# docker compose --env-file .env.intranet -f deploy/compose.intranet.yaml ...
# This private file is loaded into both API and Worker. Never commit it.
ALMRAG_INTRANET_HTTP_ENABLED=true
# Change BOTH to the actual intranet address/hostname used in the browser.
ALMRAG_ALLOWED_ORIGIN=http://127.0.0.1:8080
ALMRAG_BIND_ADDRESS=127.0.0.1
ALMRAG_HTTP_PORT=8080
# Relative to deploy/compose.intranet.yaml (not current working directory).
ALMRAG_CONFIG_DIR=../config

# Leave disabled until the corresponding real server is prepared.
ALMRAG_LIVE_ALM_ENABLED=false
ALMRAG_LIVE_MODEL_ENABLED=false
ALMRAG_LIVE_VECTOR_ENABLED=false
ALMRAG_NOTION_SUMMARY_ENABLED=false
ALMRAG_ALLOWED_ALM_ORIGINS=
ALMRAG_OLLAMA_BASE_URL=http://host.docker.internal:11434
ALMRAG_QDRANT_URL=http://qdrant:6333
ALMRAG_QDRANT_AUTH_REF=env:ALMRAG_QDRANT_API_KEY
# Generate a random value on the server even when using an external vector DB.
# ALMRAG_QDRANT_API_KEY=<server-generated secret>
# Choose container paths under /app/config for these optional settings:
# ALMRAG_MODEL_PROFILE_PATH=/app/config/model-profile.json
# ALMRAG_CA_BUNDLE=/app/config/company-ca.pem
# ALMRAG_OLLAMA_AUTH_REF=env:ALMRAG_OLLAMA_TOKEN
# ALMRAG_OLLAMA_TOKEN=<actual value only in private .env.intranet>
# ALMRAG_MASTER_KEY=<Fernet key, required only for vault: references>
# ALMRAG_CODEBEAMER_PASSWORD=<actual value only in private .env.intranet>
# ALMRAG_POLARION_TOKEN=<actual value only in private .env.intranet>
# UI auth_ref: env:ALMRAG_CODEBEAMER_PASSWORD or env:ALMRAG_POLARION_TOKEN
# Source CA path reference: env:ALMRAG_ALM_CA_PATH
# ALMRAG_ALM_CA_PATH=/app/config/company-ca.pem
