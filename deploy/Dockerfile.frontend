# DRAFT - frontend/ and package-lock.json must be created in M1/M5
FROM node:22-alpine AS build
WORKDIR /app
# M1/M5: COPY frontend/package.json frontend/package-lock.json ./
# M1/M5: RUN npm ci --omit=optional
# M1/M5: COPY frontend/ ./
# M1/M5: RUN npm run build
FROM nginx:alpine AS runtime
# M5: COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
